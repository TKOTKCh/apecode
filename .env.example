# ApeCode 配置文件
# 复制此文件为 .env 并填入你的实际配置

# 模型提供商: openai / anthropic / kimi
APECODE_PROVIDER=openai

# 模型名称
APECODE_MODEL=gpt-4.1-mini

# ========== OpenAI 配置 ==========
OPENAI_API_KEY=你的_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ========== Anthropic 配置 ==========
# ANTHROPIC_API_KEY=你的_anthropic_api_key
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ========== Kimi 配置 ==========
# KIMI_API_KEY=你的_kimi_api_key
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ========== 其他配置 ==========
# APECODE_SANDBOX_MODE=workspace-write
# APECODE_APPROVAL_POLICY=on-request
