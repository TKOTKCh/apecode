      "output": "正在运行快速审查...",
      "agent_input_template": "审查此任务：\\n{args}"
    }
  ],
  "skills": [
    {
      "name": "plugin-skill",
      "description": "一个插件提供的技能",
      "content": "# 插件技能\\n\\n保持输出简洁。"
    }
  ]
